# Copy to .env to override defaults. Every setting is also a plain environment variable.

# --- Model ---------------------------------------------------------------------------------
# tiny | base | small | medium | large-v3 — larger is more accurate and slower.
TRANSCRIBE_WHISPER_MODEL=base
TRANSCRIBE_DEVICE=cpu
# int8 on CPU, float16 on GPU.
TRANSCRIBE_COMPUTE_TYPE=int8
# Where model weights are cached. Defaults to the Hugging Face cache.
# TRANSCRIBE_DOWNLOAD_ROOT=./models

# --- Decoding ------------------------------------------------------------------------------
TRANSCRIBE_BEAM_SIZE=5
# Skips silence and suppresses hallucination loops. Leave on.
TRANSCRIBE_VAD_FILTER=true
TRANSCRIBE_CONDITION_ON_PREVIOUS_TEXT=false

# --- Diarisation ---------------------------------------------------------------------------
# Label who spoke each segment. Opt-in because it is estimated at 1.7-2x the compute of a
# plain transcript, and it forces word timestamps on so the alignment has tight boundaries.
TRANSCRIBE_DIARISE=false
# No segmentation/embedding model ships with this project, so `none` is the only value and
# asking for diarisation returns a `diarisation_unavailable` status. The accurate option,
# pyannote, has weights gated behind a Hugging Face licence acceptance, which would break the
# fully-offline, no-token setup. See docs/DESIGN.md.
TRANSCRIBE_DIARISATION_BACKEND=none
# Diarisation reads the audio on its own fixed, overlapping grid rather than reusing the
# silence-aligned transcription windows. The overlap is what stops a turn being split into two
# fragments too short to embed.
TRANSCRIBE_DIARISATION_WINDOW_SECONDS=120
TRANSCRIBE_DIARISATION_OVERLAP_SECONDS=15
# Cosine distance at which speaker clustering stops merging. This is *the* tunable and it is
# an unvalidated placeholder: choosing it honestly needs labelled audio this project does not
# have. Lower over-splits one speaker, which a human can merge; higher merges two speakers,
# which nobody can undo without re-running the job.
TRANSCRIBE_DIARISATION_THRESHOLD=0.55
# Turns shorter than this are labelled from their neighbours instead of clustered — an
# embedding from a few hundred milliseconds of speech is close to noise.
TRANSCRIBE_DIARISATION_MIN_EMBEDDING_SECONDS=1.0

# --- Limits --------------------------------------------------------------------------------
# Hard ceiling for any transcription, CLI included (seconds).
TRANSCRIBE_MAX_DURATION_SECONDS=14400
# The synchronous HTTP endpoint's stricter ceiling (seconds).
TRANSCRIBE_MAX_SYNC_DURATION_SECONDS=600
TRANSCRIBE_MAX_UPLOAD_BYTES=209715200

# --- Concurrency ---------------------------------------------------------------------------
# Simultaneous transcriptions allowed in one process. Keep at or below core count.
TRANSCRIBE_MAX_CONCURRENT_TRANSCRIPTIONS=2
