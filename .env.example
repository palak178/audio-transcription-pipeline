# Copy to .env to override defaults. Every setting is also a plain environment variable.

# --- Model ---------------------------------------------------------------------------------
# tiny | base | small | medium | large-v3 — larger is more accurate and slower.
TRANSCRIBE_WHISPER_MODEL=base
TRANSCRIBE_DEVICE=cpu
# int8 on CPU, float16 on GPU.
TRANSCRIBE_COMPUTE_TYPE=int8
# Where model weights are cached. Defaults to the Hugging Face cache.
# TRANSCRIBE_DOWNLOAD_ROOT=./models

# --- Decoding ------------------------------------------------------------------------------
TRANSCRIBE_BEAM_SIZE=5
# Skips silence and suppresses hallucination loops. Leave on.
TRANSCRIBE_VAD_FILTER=true
TRANSCRIBE_CONDITION_ON_PREVIOUS_TEXT=false

# --- Limits --------------------------------------------------------------------------------
# Hard ceiling for any transcription, CLI included (seconds).
TRANSCRIBE_MAX_DURATION_SECONDS=14400
# The synchronous HTTP endpoint's stricter ceiling (seconds).
TRANSCRIBE_MAX_SYNC_DURATION_SECONDS=600
TRANSCRIBE_MAX_UPLOAD_BYTES=209715200

# --- Concurrency ---------------------------------------------------------------------------
# Simultaneous transcriptions allowed in one process. Keep at or below core count.
TRANSCRIBE_MAX_CONCURRENT_TRANSCRIPTIONS=2
