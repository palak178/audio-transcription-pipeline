# Copy to .env to override defaults. Every setting is also a plain environment variable.

# --- Model ---------------------------------------------------------------------------------
# tiny | base | small | medium | large-v3 — larger is more accurate and slower.
TRANSCRIBE_WHISPER_MODEL=base
TRANSCRIBE_DEVICE=cpu
# int8 on CPU, float16 on GPU.
TRANSCRIBE_COMPUTE_TYPE=int8
# Where model weights are cached. Defaults to the Hugging Face cache.
# TRANSCRIBE_DOWNLOAD_ROOT=./models

# --- Decoding ------------------------------------------------------------------------------
TRANSCRIBE_BEAM_SIZE=5
# Skips silence and suppresses hallucination loops. Leave on.
TRANSCRIBE_VAD_FILTER=true
TRANSCRIBE_CONDITION_ON_PREVIOUS_TEXT=false

# --- Diarisation ---------------------------------------------------------------------------
# Label who spoke each segment. Opt-in because it is estimated at 1.7-2x the compute of a
# plain transcript, and it forces word timestamps on so the alignment has tight boundaries.
TRANSCRIBE_DIARISE=false
# No segmentation/embedding model ships with this project, so `none` is the only value and
# asking for diarisation returns a `diarisation_unavailable` status. The accurate option,
# pyannote, has weights gated behind a Hugging Face licence acceptance, which would break the
# fully-offline, no-token setup. See docs/DESIGN.md.
# `none` or `onnx`. The onnx backend needs `pip install -e ".[diarise]"` and one run of
# `transcribe diarise-warm` to fetch a 28 MB ungated CAM++ model. pyannote would be more
# accurate and is not offered: its weights are gated behind a Hugging Face licence, which would
# make an account and a token a build requirement for everyone using this project.
TRANSCRIBE_DIARISATION_BACKEND=none
# Where the speaker-embedding model lives. Defaults beside the Whisper weights.
# TRANSCRIBE_DIARISATION_MODEL_PATH=
# Boundary resolution. This backend has no neural speaker-change detector, so a turn boundary
# lands on this grid rather than where the speaker actually changed. Shorter is sharper but
# gives noisier embeddings.
TRANSCRIBE_DIARISATION_SUBSEGMENT_SECONDS=1.5
# Adjacent turns by the same speaker closer than this are merged. Sub-segmentation produces
# many small pieces; without this one monologue would be reported as dozens of turns.
TRANSCRIBE_DIARISATION_MERGE_GAP_SECONDS=0.75
TRANSCRIBE_DIARISATION_THREADS=2
# Diarisation reads the audio on its own fixed, overlapping grid rather than reusing the
# silence-aligned transcription windows. The overlap is what stops a turn being split into two
# fragments too short to embed.
TRANSCRIBE_DIARISATION_WINDOW_SECONDS=120
TRANSCRIBE_DIARISATION_OVERLAP_SECONDS=15
# Cosine distance at which speaker clustering stops merging. This is *the* tunable and it is
# an unvalidated placeholder: choosing it honestly needs labelled audio this project does not
# have. Lower over-splits one speaker, which a human can merge; higher merges two speakers,
# which nobody can undo without re-running the job.
TRANSCRIBE_DIARISATION_THRESHOLD=0.55
# Turns shorter than this are labelled from their neighbours instead of clustered — an
# embedding from a few hundred milliseconds of speech is close to noise.
TRANSCRIBE_DIARISATION_MIN_EMBEDDING_SECONDS=1.0

# --- Storage -------------------------------------------------------------------------------
# `filesystem` or `s3`. Filesystem is the default deliberately: requiring an S3 account would
# cost this project the offline, no-credentials property. Both use the same content-addressed
# key layout, so switching does not rewrite any URI.
TRANSCRIBE_BLOB_STORE=filesystem
TRANSCRIBE_BLOB_ROOT=./var/blobs
# Only read when TRANSCRIBE_BLOB_STORE=s3. Needs the optional extra: pip install -e ".[s3]"
# TRANSCRIBE_S3_BUCKET=my-transcription-audio
# TRANSCRIBE_S3_PREFIX=
# TRANSCRIBE_S3_REGION=eu-west-2
# Point at MinIO, Ceph or R2 instead of AWS.
# TRANSCRIBE_S3_ENDPOINT_URL=http://localhost:9000
# A voice recording is biometric personal data, so encryption at rest is a design constraint.
# TRANSCRIBE_S3_SSE=aws:kms
# TRANSCRIBE_S3_SSE_KMS_KEY_ID=

# --- Asynchronous job tier -----------------------------------------------------------------
# Mounts /v1/jobs and migrates on startup. Off by default: the synchronous endpoint needs
# nothing but ffmpeg and a model, and a fresh clone must keep working with no database.
TRANSCRIBE_JOBS_ENABLED=false
# Require a per-tenant API key on /v1/jobs. Off by default so a fresh clone works; the process
# warns on every start while the tier is mounted without it. Mint keys with
# `transcribe apikey create`. Keys are stored as a SHA-256 digest, never in plaintext.
TRANSCRIBE_AUTH_REQUIRED=false
TRANSCRIBE_DATABASE_URL=postgresql:///transcription
# Postgres is both the job store and the queue, via SELECT ... FOR UPDATE SKIP LOCKED. One
# datastore means claiming a job and recording that it was claimed are the same statement.
TRANSCRIBE_DATABASE_POOL_MIN=1
TRANSCRIBE_DATABASE_POOL_MAX=8
# How long a claimed job stays leased without a heartbeat. A worker that dies stops extending
# it and the job becomes claimable again.
TRANSCRIBE_JOB_LEASE_SECONDS=60
# Must be comfortably more frequent than the lease, or a healthy worker loses live work.
TRANSCRIBE_JOB_HEARTBEAT_SECONDS=15
TRANSCRIBE_JOB_MAX_ATTEMPTS=5
# Backoff is expressed as available_at in the future, not as a second queue.
TRANSCRIBE_JOB_BACKOFF_BASE_SECONDS=5
TRANSCRIBE_JOB_BACKOFF_MAX_SECONDS=600
TRANSCRIBE_WORKER_POLL_SECONDS=2
# Estimated compute above which a job goes to the `long` queue, so a batch of multi-hour
# recordings cannot starve interactive clips. Compared against duration x expected RTF, not
# duration, because diarisation roughly doubles the cost.
TRANSCRIBE_LONG_JOB_THRESHOLD_SECONDS=600

# --- Limits --------------------------------------------------------------------------------
# Hard ceiling for any transcription, CLI included (seconds).
TRANSCRIBE_MAX_DURATION_SECONDS=14400
# The synchronous HTTP endpoint's stricter ceiling (seconds).
TRANSCRIBE_MAX_SYNC_DURATION_SECONDS=600
TRANSCRIBE_MAX_UPLOAD_BYTES=209715200

# --- Concurrency ---------------------------------------------------------------------------
# Simultaneous transcriptions allowed in one process. Keep at or below core count.
TRANSCRIBE_MAX_CONCURRENT_TRANSCRIPTIONS=2
